{
    "name": "dehasoft/panel-agent",
    "description": "Sends site events (contact form messages, health checks) to the Dehasoft control panel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0 || ^12.0",
        "orchestra/testbench": "^11.2"
    },
    "autoload": {
        "psr-4": {
            "Dehasoft\\PanelAgent\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dehasoft\\PanelAgent\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dehasoft\\PanelAgent\\Laravel\\PanelAgentServiceProvider"
            ],
            "aliases": {
                "PanelAgent": "Dehasoft\\PanelAgent\\Laravel\\Facades\\PanelAgent"
            }
        }
    },
    "minimum-stability": "stable"
}
